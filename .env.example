# ==========================================================================
# FortiNex PhishGuard - Environment Variables
# Copy this file to `.env` for local development, and set the same values
# in Netlify: Site settings -> Environment variables (Build & deploy > Environment).
# ==========================================================================

# --- Database (REQUIRED for production / Netlify) -------------------------
# A real, persistent PostgreSQL connection string. Netlify Functions run on an
# ephemeral filesystem, so SQLite (file-based) is NOT usable in production -
# the server will refuse to start without this on Netlify/Vercel/Lambda.
# Easiest options: Netlify DB (Neon) from the Netlify UI, https://neon.tech,
# or https://supabase.com - all have a free tier and give you a connection
# string of the form below.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Authentication ---------------------------------------------------------
# Secret used to sign admin session JWTs. MUST be a long random string in
# production - generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Default administrator account, created on first boot if it doesn't exist yet.
# Change these before deploying - do not use the sample values in production.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Extension / API URL ----------------------------------------------------
# The public HTTPS URL of your deployed server. On Netlify this is normally
# auto-detected at build time from Netlify's own `URL` env var, so you usually
# do NOT need to set this manually. Set it explicitly only if you're using a
# custom domain and want to pin the value, or you're deploying somewhere other
# than Netlify (e.g. a standalone Node host).
PRODUCTION_API_URL=

# --- Local/standalone server only ------------------------------------------
# Port for `npm run dev` / `npm start` when NOT running as a serverless
# function (ignored on Netlify).
SERVER_PORT=3000
